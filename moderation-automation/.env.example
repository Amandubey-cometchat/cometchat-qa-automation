# Copy to .env.<name> (staging-us, prod-eu, prod-us, prod-in) and fill in.
# Dashboard -> your app -> API & Auth Keys.

COMETCHAT_APP_ID=
COMETCHAT_REGION=          # us | eu | in
COMETCHAT_REST_API_KEY=    # fullAccess scope — test setup/cleanup and moderation checks
COMETCHAT_AUTH_KEY=        # authOnly scope — the sample app logs users in with this

# Only for dedicated deployments (e.g. staging-us on cometchat-staging.com).
# Leave blank for standard apps.
COMETCHAT_ADMIN_HOST=
COMETCHAT_CLIENT_HOST=
